<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kharcha.Splash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/splashWhite</item>
        <item name="android:statusBarColor">@color/splashWhite</item>
        <item name="android:navigationBarColor">@color/splashWhite</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 12+: hide the system launcher-icon splash (the first splash). -->
        <item name="android:windowSplashScreenBackground">@color/splashWhite</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splashWhite</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
